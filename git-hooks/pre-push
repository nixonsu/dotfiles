#!/usr/bin/env bash

# Gitleaks pre-push hook
# Scans the working tree for secrets before allowing a push.
# To bypass in an emergency: git push --no-verify

set -euo pipefail

if ! command -v gitleaks &>/dev/null; then
    echo "WARNING: gitleaks is not installed — skipping secret scan."
    echo "Install it by rerunning ./install.sh (pinned Nix toolchain)."
    exit 0
fi

echo "Running gitleaks to check for secrets..."

if ! gitleaks dir --verbose; then
    echo ""
    echo "❌ gitleaks detected secrets in your dotfiles."
    echo "Please remove them before pushing."
    echo ""
    echo "If this is a false positive, you can:"
    echo "  1. Add a .gitleaksignore file (see https://github.com/gitleaks/gitleaks#gitleaksignore)"
    echo "  2. Bypass this check with: git push --no-verify"
    exit 1
fi
